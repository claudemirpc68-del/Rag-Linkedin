LINKEDIN_ACCESS_TOKEN=seu_access_token_aqui
LINKEDIN_AUTHOR_URN=urn:li:person:seu_sub_ou_person_id
LINKEDIN_API_VERSION=202602

# Servidor Web
PORT=3000
HOST=127.0.0.1
